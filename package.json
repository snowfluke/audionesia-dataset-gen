{
  "name": "audionesia-dataset-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Static web app that builds an Indonesian TTS training dataset: phoneme-balanced scripts, in-browser recording, IndexedDB storage, StyleTTS2 and PocketTTS export.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint src tests scripts",
    "lint:fix": "oxlint --fix src tests scripts",
    "fmt": "oxfmt --check src tests scripts docs",
    "fmt:fix": "oxfmt src tests scripts docs",
    "test": "bun test",
    "complete-check": "bun run type-check && bun run lint && bun run fmt && bun test && bun run build",
    "corpus:common-voice": "bun scripts/corpus/fetch-common-voice.ts",
    "corpus:tatoeba": "bun scripts/corpus/fetch-tatoeba.ts",
    "corpus:wikipedia": "bun scripts/corpus/fetch-wikipedia.ts",
    "corpus:news": "bun scripts/corpus/scrape-news.ts",
    "corpus:llm": "bun scripts/corpus/generate-llm.ts",
    "corpus:build": "bun scripts/corpus/build-corpus.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.3",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "indo-g2p": "0.1.2",
    "solid-js": "2.0.0-rc.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/kumo": "2.12.0",
    "@oxlint/plugins": "1.80.0",
    "@solidjs/vite-plugin": "3.0.0-next.34",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.14",
    "eslint-plugin-solid": "0.16.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
